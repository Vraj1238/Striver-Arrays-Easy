Return true baad me likh sakte hai no else statement needed

bool is_sorted(vector<int> &arr,int n){
    for(int i=0;i<n-1;i++){
        if(arr[i] > arr[i+1]){
            return false;
        }
    }
    return true;
}   
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    cout << is_sorted(arr,n);
}
