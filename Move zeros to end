//Brute
//TC :- O(2N)  and  SC :- O(N)
void zeors_back(vector<int> &arr,int n){
    vector<int> temp;

    for(int i = 0; i < n; i++){
        if(arr[i] != 0){
            temp.push_back(arr[i]);
        }
    }
    int nz = temp.size();
    for(int i = 0; i < nz; i++){
        arr[i] = temp[i];
    }
    for(int i = nz; i < n; i++){
        arr[i] = 0;
    }
}
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    zeors_back(arr,n);
    for(int i=0;i<n;i++){
            cout << arr[i] << " ";
    }
}

//Optimal
//TC :- O(N)  and  SC :- O(1)
void zeors_back_1(vector<int> &arr,int n){
    int j=-1;           //jab nahi pata ho kaha se start
    for(int i=0;i<n;i++){
        if(arr[i] == 0){
            j = i;
            break;
        }
    }
    for(int i=j+1;i<n;i++){
        if(arr[j]==0 && arr[i]!=0){
            swap(arr[i],arr[j]);
            j++;
        }
    }
}
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    zeors_back_1(arr,n);
    for(int i=0;i<n;i++){
            cout << arr[i] << " ";
    }
}
