//Brute
//TC :- O(N^3) nearly              SC :-O(1)
int longest_subarray(vector<int> &arr, int n, int k){
    int maxLen = 0;
    for(int i = 0; i < n; i++){
        for(int j = i; j < n; j++){
            int sum = 0;
            for(int p = i; p <= j; p++){
                sum += arr[p];
            }
            if(sum == k){
                maxLen = max(maxLen, j - i + 1);
            }
        }
    }
    return maxLen;
}
//Brute
//TC :- O(N^2) nearly              SC :-O(1)
int longest_subarray_1(vector<int> &arr, int n, int k){
    int maxLen = 0;
    for(int i = 0; i < n; i++){
        int sum = 0;
        for(int j = i; j < n; j++){
            //No another loop 
            sum += arr[j];
            if(sum == k){
                maxLen = max(maxLen, j - i + 1);
            }
        }
    }
    return maxLen;
}
//Better (Optimal if it contain +ve and -ve elements)
//TC :- O(NlogN) or O(N)              SC :-O(N)
int longest_subarray_2(vector<int> a, int n,long long k) {
    map<long long, int> preSumMap;
    long long sum = 0;
    int maxLen = 0;
    for(int i = 0; i < a.size(); i++) {
        sum += a[i];
        // Case 1: subarray starts from index 0
        if(sum == k) {
            maxLen = max(maxLen, i + 1);
        }
        // Case 2: subarray starts after index 0
        long long rem = sum - k;
        if(preSumMap.find(rem) != preSumMap.end()) {
            int len = i - preSumMap[rem];
            maxLen = max(maxLen, len);
        }


        //if this is used directly and only (it is only for positive elements)
        //preSumMap[sum] = i;


        // Store the first occurrence of this prefix sum
        if(preSumMap.find(sum) == preSumMap.end()) {
            preSumMap[sum] = i;
        }
    }
    return maxLen;
}
//Optimal
//TC :- O(2N)              SC :- O(1)
int longest_subarray_3(vector<int> &arr, int n, int k) {
    int maxLen = 0;
    int left = 0;
    int right = 0;
    long long sum = arr[0];
    while(right < n) {
        while(left <= right && sum > k) {
            sum -= arr[left];
            left++;
        }
        if(sum == k) {
            maxLen = max(maxLen, right - left + 1);
        }
        right++;
        if(right < n) {
            sum += arr[right];
        }
    }
    return maxLen;
}
int main() {
    int n;
    cin >> n;
    int k;
    cin >> k;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    cout << longest_subarray_3(arr, n, k);
}
