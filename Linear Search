//TC :- O(N)  and  SC :- O(1)
int linear_search(vector<int> &arr,int n,int target){
    for(int i=0;i<n;i++){
        if(arr[i] == target) return i;
    }
    return -1;
}
int main(){
    int n;
    cin >> n;
    int target;
    cin >> target;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    cout << linear_search(arr,n,target);
}
