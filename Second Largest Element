Better Solution (TC :- O(3N))
int sec_largest(vector<int> &arr,int n){
    int max = 0;
    int sec_max = 0;
    for(int i=0;i<n;i++){
        if(arr[i]>arr[max]){
            max = i;
        }
    }
    for(int i=0;i<n;i++){
        if(arr[max] != arr[i]){
            sec_max = i;
            break;
        }
        else if(i == n-1){
            return -1;
        }
    }
    for(int i=0;i<n;i++){
        if(arr[i] < arr[max] && arr[i] > arr[sec_max]){
            sec_max = i;
        }
    }
    return arr[sec_max];
}
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    cout << sec_largest(arr,n);
}

Optimal Solution(TC :- O(N))  and (SC :- O(N))
int sec_largest2(vector<int> &arr,int n){
    int largest = arr[0];
    int slargest = -1;
    for(int i=1;i<n;i++){
        if(arr[i] > largest){
            slargest = largest;
            largest = arr[i];
        }
        else if(arr[i] < largest && arr[i] > slargest){
            slargest = arr[i];
        }
    }
    return slargest;
}
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin >> arr[i];
    }
    cout << sec_largest2(arr,n);
}
